rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Shared Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == "my.ability.is.my.goal@gmail.com" && request.auth.token.email_verified == true) ||
        request.auth.uid == "tfw1pd6SzlP1DK91BwXfj8AUvsA3"
      );
    }

    function isBusiness(data) {
      return data.get('role', '') == 'business';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Entity Validators
    // ===============================================================
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'tokenBalance', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.tokenBalance is number && data.tokenBalance >= 0 &&
             data.role in ['user', 'admin', 'business'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 20)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['ownerId', 'name', 'price', 'category']) &&
             data.ownerId is string && isValidId(data.ownerId) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'rating', 'comment', 'businessId']) &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() <= 2000 &&
             data.businessId is string && isValidId(data.businessId);
    }

    function isValidProductAlert(data) {
      return data.keys().hasAll(['userId', 'productId', 'type']) &&
             data.userId == request.auth.uid &&
             data.productId is string && isValidId(data.productId) &&
             data.type in ['price', 'stock', 'both'];
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Users
    match /users/{userId} {
      // Businesses profiles should be publicly readable/listable
      allow get: if true; // Profile pages are public
      allow list: if isSignedIn() || resource.data.role == 'business';
      
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                      incoming().tokenBalance == 100 && 
                      incoming().role == 'user';
      
      allow update: if (isOwner(userId) && 
                      isValidUser(incoming()) &&
                      (incoming().role == existing().role || (existing().role == 'user' && incoming().role == 'business')) &&
                      (incoming().tokenBalance == existing().tokenBalance || isAdmin())) || isAdmin();
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidProduct(incoming());
      allow update: if (isSignedIn() && existing().ownerId == request.auth.uid && isValidProduct(incoming()) && 
                       incoming().ownerId == existing().ownerId) || isAdmin();
      allow delete: if (isSignedIn() && existing().ownerId == request.auth.uid) || isAdmin();
    }

    // Product Alerts
    match /productAlerts/{alertId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidProductAlert(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidReview(incoming()) &&
                       incoming().userId == existing().userId && incoming().businessId == existing().businessId;
      allow delete: if (isSignedIn() && existing().userId == request.auth.uid) || isAdmin();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().fromId == request.auth.uid;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.businessId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.businessId == request.auth.uid || isAdmin());
    }

    match /businesses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /news/{id} { allow read: if true; allow write: if isAdmin(); }
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
    }
    match /messages/{id} {
      allow read: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
    }
    match /reminders/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Fallback for other identified collections (mostly public read, admin write)
    match /courses/{id} { allow read: if true; allow write: if isAdmin(); }
    match /books/{id} { allow read: if true; allow write: if isAdmin(); }
    match /wordbank/{id} { allow read: if true; allow write: if isAdmin(); }
    match /art/{id} { allow read: if true; allow write: if isAdmin(); }
    match /culture/{id} { allow read: if true; allow write: if isAdmin(); }
    
    match /riddles/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }
    
    match /posts/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().authorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().authorId == request.auth.uid || isAdmin());
    }

    match /apks/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /apk_versions/{id} {
      allow read: if true;
      allow create: if isSignedIn(); // Should ideally check parent APK owner
      allow update, delete: if isAdmin();
    }

    match /notes/{id} {
      allow read, write: if isSignedIn() && (
        (request.method == 'create' && incoming().userId == request.auth.uid) ||
        (request.method != 'create' && existing().userId == request.auth.uid)
      );
    }

    match /questions/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
